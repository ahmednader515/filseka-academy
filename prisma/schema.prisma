generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                                                String                     @id @default(cuid())
  email                                                             String                     @unique
  password                                                          String                     @map("password_hash")
  name                                                              String
  role                                                              String                     @default("STUDENT")
  balance                                                           Decimal                    @default(0) @db.Decimal(10, 2)
  createdAt                                                         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                                         DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  student_number                                                    String?
  guardian_number                                                   String?
  current_session_id                                                String?
  copyrightCode                                                     String?                    @unique(map: "user_copyright_code_unique", where: raw("((copyright_code IS NOT NULL) AND (TRIM(BOTH FROM copyright_code) <> ''::text))")) @map("copyright_code") @db.VarChar(10)
  teacherSubject                                                    String?                    @map("teacher_subject")
  teacherAvatarUrl                                                  String?                    @map("teacher_avatar_url")
  /// 1–4 = ترتيب البطاقة في الرئيسية؛ null = يُكمّل تلقائياً بعد المحددين (حتى 4)
  teacherHomepageOrder                                              Int?                       @map("teacher_homepage_order")
  ActivationCode                                                    ActivationCode[]
  Conversation_Conversation_staff_user_idToUser                     Conversation[]             @relation("Conversation_staff_user_idToUser")
  Conversation_Conversation_student_user_idToUser                   Conversation[]             @relation("Conversation_student_user_idToUser")
  coursesCreated                                                    Course[]                   @relation("CourseCreator")
  CourseCertificate                                                 CourseCertificate[]
  enrollments                                                       Enrollment[]
  HomeworkSubmission                                                HomeworkSubmission[]
  LessonCompletion                                                  LessonCompletion[]
  LessonRating                                                      LessonRating[]
  Message                                                           Message[]
  PasswordChangeRequest_PasswordChangeRequest_processed_by_idToUser PasswordChangeRequest[]    @relation("PasswordChangeRequest_processed_by_idToUser")
  PasswordChangeRequest_PasswordChangeRequest_user_idToUser         PasswordChangeRequest[]    @relation("PasswordChangeRequest_user_idToUser")
  Payment                                                           Payment[]
  quizAttempts                                                      QuizAttempt[]
  UserPlatformSubscription                                          UserPlatformSubscription[]
  UserStorePurchase                                                 UserStorePurchase[]
}

model Category {
  id          String   @id @default(cuid())
  name        String
  nameAr      String?  @map("name_ar")
  slug        String   @unique
  description String?
  imageUrl    String?  @map("image_url")
  order       Int      @default(0)
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  courses     Course[]
}

model Course {
  id                 String               @id @default(cuid())
  title              String
  titleAr            String?              @map("title_ar")
  slug               String               @unique
  description        String
  description_en     String?
  shortDesc          String?              @map("short_desc") @db.VarChar(300)
  short_desc_en      String?              @db.VarChar(300)
  imageUrl           String?              @map("image_url")
  price              Decimal              @default(0) @db.Decimal(10, 2)
  duration           String?
  level              String?
  isPublished        Boolean              @default(false) @map("is_published")
  order              Int                  @default(0)
  maxQuizAttempts    Int?                 @map("max_quiz_attempts")
  categoryId         String?              @map("category_id")
  createdById        String?              @map("created_by_id")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  accepts_homework   Boolean              @default(false)
  ActivationCode     ActivationCode[]
  CertificateCourse  CertificateCourse?
  category           Category?            @relation(fields: [categoryId], references: [id], onUpdate: NoAction)
  createdBy          User?                @relation("CourseCreator", fields: [createdById], references: [id], onUpdate: NoAction)
  CourseCertificate  CourseCertificate[]
  enrollments        Enrollment[]
  HomeworkSubmission HomeworkSubmission[]
  lessons            Lesson[]
  LessonRating       LessonRating[]
  LiveStream         LiveStream[]
  Payment            Payment[]
  quizzes            Quiz[]

  @@index([categoryId])
  @@index([createdById])
  @@index([slug])
}

model Quiz {
  id                 String               @id @default(cuid())
  courseId           String               @map("course_id")
  title              String
  order              Int                  @default(0)
  timeLimitMinutes   Int?                 @map("time_limit_minutes")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  ActivationCodeQuiz ActivationCodeQuiz[]
  questions          Question[]
  course             Course               @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quizAttempts       QuizAttempt[]

  @@index([courseId])
}

model Question {
  id               String           @id @default(cuid())
  quizId           String           @map("quiz_id")
  type             String
  questionText     String           @map("question_text")
  questionImageUrl String?          @map("question_image_url")
  order            Int              @default(0)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  quiz             Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  options          QuestionOption[]

  @@index([quizId])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String   @map("question_id")
  text       String
  isCorrect  Boolean  @default(false) @map("is_correct")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([questionId])
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  courseId   String   @map("course_id")
  enrolledAt DateTime @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([userId])
}

model QuizAttempt {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  quizId         String   @map("quiz_id")
  score          Int
  totalQuestions Int      @map("total_questions")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([userId, quizId], map: "QuizAttempt_user_quiz_idx")
}

model Lesson {
  id                   String                 @id @default(cuid())
  courseId             String                 @map("course_id")
  title                String
  titleAr              String?                @map("title_ar")
  slug                 String
  content              String?
  videoUrl             String?                @map("video_url")
  pdfUrl               String?                @map("pdf_url")
  duration             Int?
  order                Int                    @default(0)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  accepts_homework     Boolean                @default(false)
  homeworkImageUrl     String?                @map("homework_image_url")
  ActivationCodeLesson ActivationCodeLesson[]
  HomeworkSubmission   HomeworkSubmission[]
  course               Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  LessonCompletion     LessonCompletion[]
  LessonRating         LessonRating[]

  @@unique([courseId, slug])
  @@index([courseId])
}

model ActivationCode {
  id                   String                 @id
  course_id            String
  code                 String                 @unique
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  used_at              DateTime?              @db.Timestamptz(6)
  used_by_user_id      String?
  Course               Course                 @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User                 User?                  @relation(fields: [used_by_user_id], references: [id], onUpdate: NoAction)
  ActivationCodeLesson ActivationCodeLesson[]
  ActivationCodeQuiz   ActivationCodeQuiz[]

  @@index([code])
  @@index([course_id])
  @@index([created_at])
}

model ActivationCodeLesson {
  activation_code_id String
  lesson_id          String
  ActivationCode     ActivationCode @relation(fields: [activation_code_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Lesson             Lesson         @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([activation_code_id, lesson_id])
  @@index([activation_code_id], map: "ActivationCodeLesson_code_idx")
  @@index([lesson_id], map: "ActivationCodeLesson_lesson_idx")
}

model ActivationCodeQuiz {
  activation_code_id String
  quiz_id            String
  ActivationCode     ActivationCode @relation(fields: [activation_code_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Quiz               Quiz           @relation(fields: [quiz_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([activation_code_id, quiz_id])
  @@index([activation_code_id], map: "ActivationCodeQuiz_code_idx")
  @@index([quiz_id], map: "ActivationCodeQuiz_quiz_idx")
}

model BlogPost {
  id           String    @id
  slug         String    @unique
  content      Json
  is_published Boolean   @default(false)
  published_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)
  created_by   String?
  updated_by   String?

  @@index([is_published, published_at(sort: Desc)], map: "blog_post_published_date")
}

model CertificateCourse {
  course_id String @id
  Course    Course @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model CertificateSettings {
  id         String   @id
  design     Json
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

model ContactInquiry {
  id         String   @id
  name       String
  email      String
  phone      String   @default("")
  interest   String
  message    String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([email, created_at(sort: Desc)], map: "contact_inquiry_email_created")
}

model Conversation {
  id                                      String    @id
  staff_user_id                           String
  student_user_id                         String
  created_at                              DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                              DateTime  @default(now()) @db.Timestamptz(6)
  User_Conversation_staff_user_idToUser   User      @relation("Conversation_staff_user_idToUser", fields: [staff_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User_Conversation_student_user_idToUser User      @relation("Conversation_student_user_idToUser", fields: [student_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Message                                 Message[]

  @@unique([staff_user_id, student_user_id])
  @@index([staff_user_id])
  @@index([student_user_id])
}

model CourseCertificate {
  id           String   @id
  user_id      String
  course_id    String
  student_name String
  course_title String
  design       Json
  issued_at    DateTime @default(now()) @db.Timestamptz(6)
  Course       Course   @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User         User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, course_id])
}

