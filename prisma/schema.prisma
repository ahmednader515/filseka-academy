/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model HomeworkSubmission {
  id              String   @id
  course_id       String
  user_id         String
  submission_type String
  link_url        String?
  file_url        String?
  file_name       String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  lesson_id       String?
  Course          Course   @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Lesson          Lesson?  @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User            User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([course_id])
  @@index([created_at])
  @@index([lesson_id])
  @@index([user_id])
}

model LessonCompletion {
  user_id      String
  lesson_id    String
  completed_at DateTime @default(now()) @db.Timestamptz(6)
  Lesson       Lesson   @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User         User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, lesson_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model LessonRating {
  id         String   @id
  lesson_id  String
  user_id    String
  course_id  String
  rating     Int
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  Course     Course   @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Lesson     Lesson   @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([lesson_id, user_id], map: "lesson_rating_unique_lesson_user")
  @@index([course_id])
  @@index([lesson_id])
  @@index([user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model LiveStream {
  id               String   @id
  course_id        String
  title            String
  title_ar         String?
  provider         String
  meeting_url      String
  meeting_id       String?
  meeting_password String?
  scheduled_at     DateTime @db.Timestamptz(6)
  description      String?
  order            Int      @default(0)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @db.Timestamptz(6)
  Course           Course   @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([course_id])
  @@index([scheduled_at])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Message {
  id              String       @id
  conversation_id String
  sender_id       String
  message_type    String
  content         String?
  file_url        String?
  file_name       String?
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  Conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User            User         @relation(fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id])
  @@index([created_at])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model PasswordChangeRequest {
  id                                               String    @id
  user_id                                          String
  new_password_hash                                String
  requested_identifier                             String?
  requested_old_password                           String?
  requested_new_password_plain                     String?
  status                                           String    @default("pending")
  created_at                                       DateTime  @default(now()) @db.Timestamptz(6)
  processed_at                                     DateTime? @db.Timestamptz(6)
  processed_by_id                                  String?
  User_PasswordChangeRequest_processed_by_idToUser User?     @relation("PasswordChangeRequest_processed_by_idToUser", fields: [processed_by_id], references: [id], onUpdate: NoAction)
  User_PasswordChangeRequest_user_idToUser         User      @relation("PasswordChangeRequest_user_idToUser", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at(sort: Desc)])
  @@index([status])
  @@index([user_id])
}

model Payment {
  id         String   @id
  user_id    String
  course_id  String
  amount     Decimal  @db.Decimal(10, 2)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  Course     Course   @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at])
}

model PortfolioWork {
  id           String   @id
  content      Json
  is_published Boolean  @default(false)
  sort_order   Int      @default(0)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)
}

model Review {
  id              String   @id
  text            String
  text_en         String?
  author_name     String
  author_title    String?
  author_title_en String?
  avatar_letter   String?
  image_url       String?
  order           Int      @default(0)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([order])
}

model StoreProduct {
  id                String              @id
  title             String
  description       String              @default("")
  price             Decimal             @default(0) @db.Decimal(10, 2)
  image_url         String?
  pdf_url           String?
  is_active         Boolean             @default(true)
  sort_order        Int                 @default(0)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  cost_price        Decimal             @default(0) @db.Decimal(10, 2)
  UserStorePurchase UserStorePurchase[]

  @@index([is_active, sort_order, created_at(sort: Desc)], map: "StoreProduct_active_sort_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model SubscriptionPlan {
  id                       String                     @id
  name                     String
  description              String                     @default("")
  image_url                String?
  duration_kind            String
  price                    Decimal                    @default(0) @db.Decimal(10, 2)
  is_active                Boolean                    @default(true)
  sort_order               Int                        @default(0)
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                   @default(now()) @db.Timestamptz(6)
  UserPlatformSubscription UserPlatformSubscription[]

  @@index([is_active, sort_order], map: "SubscriptionPlan_active_sort_idx")
}

model UserPlatformSubscription {
  id               String            @id
  user_id          String
  plan_id          String?
  price_paid       Decimal           @default(0) @db.Decimal(10, 2)
  expires_at       DateTime          @db.Timestamptz(6)
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  SubscriptionPlan SubscriptionPlan? @relation(fields: [plan_id], references: [id], onUpdate: NoAction)
  User             User              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, expires_at], map: "UserPlatformSubscription_user_expires_idx")
}

model UserStorePurchase {
  id           String       @id
  user_id      String
  product_id   String
  price_paid   Decimal      @default(0) @db.Decimal(10, 2)
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  StoreProduct StoreProduct @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User         User         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, product_id])
  @@index([user_id, created_at(sort: Desc)], map: "UserStorePurchase_user_idx")
}
